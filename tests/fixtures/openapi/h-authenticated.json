{
  "openapi": "3.0.3",
  "info": { "title": "Fixture H: authenticated endpoints", "version": "1" },
  "security": [{ "bearer": [] }],
  "paths": {
    "/profile": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/reports": {
      "get": {
        "security": [{ "apiKey": [], "appId": [] }, { "oauth": ["reports:read"] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/legacy": { "get": { "security": [{ "ghostScheme": [] }], "responses": { "200": { "description": "ok" } } } }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "Bearer", "bearerFormat": "JWT" },
      "apiKey": { "type": "apiKey", "in": "header", "name": "X-Api-Key" },
      "appId": { "type": "apiKey", "in": "header", "name": "X-App-Id" },
      "oauth": { "type": "oauth2", "flows": { "clientCredentials": { "tokenUrl": "https://auth.example.test/token", "scopes": { "reports:read": "read" } } } }
    }
  }
}
