{
  "openapi": "3.0.0",
  "info": { "title": "Fixture D: arrays", "version": "1" },
  "paths": {
    "/projects": {
      "get": {
        "responses": {
          "200": {
            "description": "list",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "displayName": { "type": "string" },
                "ssn": { "type": "string" }
              }
            }
          },
          "milestones": { "type": "array", "items": { "$ref": "#/components/schemas/Milestone" } }
        }
      },
      "Milestone": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "dueDate": { "type": "string", "format": "date" } }
      }
    }
  }
}
