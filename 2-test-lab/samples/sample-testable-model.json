  "laws": [
    {
      "id": "LAW-001",
      "category": "BOLA",
      "severity": "High",
      "title": "Customer can access only owned Order objects.",
      "source": "Ownership field 'customerId' on Order + EP-001, EP-002, EP-004 + map 101→User A; 102→User B; 103→User A",
      "confidence": "HIGH",
      "score": 90,
      "reason": "Ownership field 'customerId' + configured map isolates Order.",
      "invariant": "∀ Customer c, order o: ALLOW(GET /users/{id}) ⟺ owner(o)==c",
      "appliesTo": {
        "endpoints": [
          "EP-001",
          "EP-002",
          "EP-004"
        ],
        "resources": [
          "Order"
        ],
        "fields": [
          "Order.customerId"
        ],
        "roles": [
          "Customer"
        ]
      },
      "tests": [
        {
          "given": "authenticated as customer_001 (User A)",
          "when": "GET /orders/101 (own, owner=customer_001)",
          "expect": "ALLOW + own data only"
        },
        {
          "given": "authenticated as customer_001 (User A)",
          "when": "GET /orders/102 (foreign, owner=customer_002)",
          "expect": "DENY (401/403/404 without leakage) — violation = BOLA"
        },
        {
          "given": "unauthenticated",
          "when": "GET /orders/101",
          "expect": "DENY (auth)"
        }
      ]
    },
    {
      "id": "LAW-002",
      "category": "ADMIN",
      "severity": "High",
      "title": "Non-Administrator roles cannot invoke admin-only actions.",
      "source": "EP-005 POST /admin/refund + admin role='Administrator'",
      "confidence": "HIGH",
      "score": 90,
      "reason": "Admin endpoints isolated to role 'Administrator'.",
      "invariant": "role!=Administrator → DENY(POST /admin/refund)",
      "appliesTo": {
        "endpoints": [
          "EP-005"
        ],
        "resources": [],
        "fields": [],
        "roles": [
          "Customer"
        ]
      },
      "tests": [
        {
          "given": "authenticated as customer_001 (non-admin)",
          "when": "POST /admin/refund",
          "expect": "DENY (403) — violation = broken access control"
        },
        {
          "given": "authenticated as admin_001 (Administrator)",
          "when": "POST /admin/refund",
          "expect": "ALLOW"
        }
      ]
    },
