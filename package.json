{
  "name": "sentinel-x",
  "version": "0.2.0",
  "private": true,
  "description": "Sentinel X: OpenAPI security modelling (Security Twin builder + test lab prototypes)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:regen": "node scripts/regen-sample.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.11"
  }
}
