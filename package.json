{
  "name": "sentinel-x",
  "version": "0.2.0",
  "private": true,
  "description": "Sentinel X: OpenAPI security modelling (Security Twin builder + test lab prototypes)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sample:regen": "node scripts/regen-sample.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.11"
  }
}
